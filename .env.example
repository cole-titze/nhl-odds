# PostgreSQL password for the postgres user (required)
POSTGRES_PASSWORD=YourStrongPassword123!

# The Odds API keys (optional — only needed for odds fetching)
ODDS_API_KEY=
API_BACKFILL_KEY=

# Required in the X-Admin-Key header to start jobs via /api/Admin/Start* (outside Development)
ADMIN_API_KEY=

# Delay between NHL API requests in ms (optional, default 250 — the API returns 429s without one)
THROTTLE_TIME_MS=

# Cloudflare Tunnel token for public access (optional, docker-compose.prod.yml only)
CLOUDFLARE_TUNNEL_TOKEN=

# CPU limit for the predictor container (optional, default 2)
PREDICTOR_CPUS=
