{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Data Collector",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/Entry/bin/Debug/net9.0/Entry.dll",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "logging": {
                "moduleLoad": false,
                "stepFiltering": false
            }
        },
        {
            "name": "Python: Backfill",
            "type": "debugpy",
            "request": "launch",
            "module": "game_predictor",
            "args": ["--mode", "backfill"],
            "cwd": "${workspaceFolder}",
            "justMyCode": true,
            "console": "internalConsole"
        },
        {
            "name": "Python: Test Models",
            "type": "debugpy",
            "request": "launch",
            "module": "game_predictor",
            "args": ["--mode", "test"],
            "cwd": "${workspaceFolder}",
            "justMyCode": true,
            "console": "internalConsole"
        },
        {
            "name": "Web API",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/WebApi/bin/Debug/net9.0/WebApi.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/WebApi",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "logging": {
                "moduleLoad": false,
                "stepFiltering": false
            },
            "presentation": {
                "hidden": true
            }
        },
        {
            "name": "Frontend",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}/frontend",
            "runtimeExecutable": "bash",
            "runtimeArgs": ["-c", "source $NVM_DIR/nvm.sh && npm run dev"],
            "env": {
                "NVM_DIR": "${env:HOME}/.nvm"
            },
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "Local:\\s+(https?://\\S+)",
                "uriFormat": "%s"
            },
            "presentation": {
                "hidden": true
            }
        }
    ],
    "compounds": [
        {
            "name": "Web App",
            "configurations": ["Web API", "Frontend"],
            "stopAll": true
        }
    ]
}
