{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router typegen && tsc -b && react-router build && vite build -c vite.sw.config.ts",
    "lint": "eslint .",
    "a11y": "node a11y/axe-scan.mjs",
    "format": "prettier --write 'src/**/*.{ts,tsx}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx}'",
    "start": "node server.mjs"
  },
  "dependencies": {
    "@react-router/express": "7.18.4",
    "@react-router/node": "7.18.4",
    "compression": "^1.8.2",
    "date-fns": "^4.4.0",
    "express": "5.3.0",
    "http-proxy-middleware": "3.0.7",
    "isbot": "5.2.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "7.18.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@react-router/dev": "7.18.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "5.0.6",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/serviceworker": "^0.0.202",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4"
  },
  "allowScripts": {
    "esbuild": true
  }
}
